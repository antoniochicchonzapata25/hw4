# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit .env. These are placeholders only.

# --- Required for the chatbot (PydanticAI agent via the Portkey gateway) ---
PORTKEY_API_KEY=your-portkey-api-key-here

# --- Optional model settings (defaults shown) ---
# Any OpenAI 5.6 / 6 series model available through Portkey.
OPENAI_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# --- Recommended: signs the login session cookie ---
# Use a long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated on every start and all users are logged out on restart.
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional: enables the manager demand report (GET /api/manager/demand, header X-Manager-Key) ---
# If unset, that endpoint returns 503.
MANAGER_API_KEY=replace-with-a-long-random-string
